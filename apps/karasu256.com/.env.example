NEXT_PUBLIC_ACCOUNTS_URL=
# URL of auth.karasu256.com, which hosts the sign-in page
NEXT_PUBLIC_AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth)
NEXT_PUBLIC_AUTH_API_URL=

# The api-auth.karasu256.com better-auth instance that issues OAuth access
# tokens — used to verify their signature (must match BETTER_AUTH_URL there).
OAUTH_ISSUER_URL=

# Cross-subdomain session sharing (optional)
# When set, session cookies (better-auth's and the legacy Firebase one) are
# cleared with Domain scoped to .{BASE_DOMAIN} to match how
# accounts.karasu256.com originally set them. Leave empty for localhost /
# single-domain deployments.
BASE_DOMAIN=

# PostgreSQL (Drizzle ORM)
DATABASE_URL=

# Server-only URL of the image-api Worker, used to upload the profile icon
CDN_URL=

# Server-only URL of api.karasu256.com, which verifies API keys and resolves their permissions
API_URL=

# Vercel Feature Flags
FLAGS_SECRET=