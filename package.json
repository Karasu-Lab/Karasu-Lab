{
  "name": "@karasu-lab/karasu-lab-web-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:auth": "pnpm --filter @karasu-lab/docker run run:android && pnpm --parallel --filter api-auth.karasu256.com --filter api.karasu256.com --filter @karasu-lab/cloudflared-config dev",
    "build": "turbo build",
    "deploy": "turbo deploy",
    "deploy:prod": "turbo deploy:prod",
    "lint": "turbo lint",
    "test:e2e": "turbo test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec pretty-quick --staged"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.3.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.5.3",
    "pretty-quick": "4.2.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vercel": "^54.21.1"
  }
}
