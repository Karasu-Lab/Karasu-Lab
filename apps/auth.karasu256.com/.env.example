# URL of the main karasu256.com app (used for the terms of service link)
NEXT_PUBLIC_APP_URL=

# URL of accounts.karasu256.com, the default destination after sign-in
NEXT_PUBLIC_ACCOUNTS_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth).
# The sign-in, consent and password-reset pages call it through the better-auth client.
NEXT_PUBLIC_AUTH_API_URL=

# Vercel Feature Flags
FLAGS_SECRET=
