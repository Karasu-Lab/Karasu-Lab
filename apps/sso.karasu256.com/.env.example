# URL of the main karasu256.com app
NEXT_PUBLIC_APP_URL=

# URL of accounts.karasu256.com, the default destination after sign-in
NEXT_PUBLIC_ACCOUNTS_URL=

# URL of auth.karasu256.com, linked for users whose organization does not use SSO
NEXT_PUBLIC_AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, the SSO plugin, passkeys, OAuth).
# The SSO sign-in page calls it through the better-auth client, and its base URL is also
# where the SAML Service Provider metadata and ACS URLs shown on the sign-in page are derived from.
NEXT_PUBLIC_AUTH_API_URL=

# Vercel Feature Flags
FLAGS_SECRET=
