{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "envMode": "loose",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["@karasu-lab/docker#run"],
      "cache": false,
      "persistent": true
    },
    "@karasu-lab/docker#run": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "deploy:prod": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    }
  }
}
