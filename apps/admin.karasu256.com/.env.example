# URL of auth.karasu256.com, which hosts the sign-in page
NEXT_PUBLIC_AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth)
NEXT_PUBLIC_AUTH_API_URL=

# Full origin URL of the main karasu256.com app (e.g. https://karasu256.com
# in production, http://localhost:3000 in local dev), used verbatim as the
# settings link destination in the header's account menu (this app has no
# settings page of its own). Required — requests fail if unset.
ROOT_APP_URL=

# This app's own public URL, used as the `next` redirect target after sign-out.
NEXT_PUBLIC_APP_URL=

# Base URL of the api.admin.karasu256.com NestJS backend. Server-only —
# the browser talks to this app's own /api/* routes, which next.config.ts
# rewrites (proxies) to this URL, including EventSource/SSE connections.
# Optional — defaults to http://localhost:3006, matching
# api.admin.karasu256.com's own default port. Set this only if that backend
# runs elsewhere.
API_URL=

# Vercel OAuth App credentials. Create the app first with the Vercel CLI
# (see README.md's "Vercel OAuth setup" section for the production guide):
#   vercel oauth-apps register --name "Karasu Lab - Dev" --slug karasu-lab-dev \
#     --redirect-uri "${NEXT_PUBLIC_APP_URL}/api/auth/callback/vercel" --format json
#   vercel oauth-apps install --client-id <id> --permission read:project --projects <project-ids>
# Optional — the Vercel deployments panel is hidden when unset. The resulting
# connection is stored in an httpOnly cookie set by this app itself (this app
# has no database of its own), not in any external store.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
